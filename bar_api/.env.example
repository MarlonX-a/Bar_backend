NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=xd

# Use at least 32 random characters in production.
JWT_SECRET=replace-with-a-long-random-secret

# Authentication session lifetimes.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ABSOLUTE_DAYS=90
TABLE_SESSION_TTL_MINUTES=240
# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server for the frontend runs on 5173.
CORS_ORIGINS=http://localhost:5173

# Set true only when the application runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Disabled by default in production. Enable only on a protected/admin network.
OPENAPI_ENABLED=true
